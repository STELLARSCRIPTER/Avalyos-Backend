# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
DATABASE_URL=postgresql://avalyos:avalyos_password@localhost:5432/avalyos_db

# Comma-separated list of allowed frontend origins (React dev server, etc.)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: require this header (X-API-Key) on requests. Leave blank to disable.
AVAL_API_KEY=

# Requests allowed per minute, per API key (or per anonymous caller if no key)
AVAL_RATE_PER_MIN=60

# Max pending Q# operations before returning 429 (only relevant if Q# is enabled)
QSHARP_QUEUE_MAX=64
